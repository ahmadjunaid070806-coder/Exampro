# Standard Application Settings (Hostinger VPS / cPanel / hPanel / Node.js)
APP_NAME="ExamPro"
APP_INSTALLED="false"
APP_KEY=""
NODE_ENV="production"
PORT="3000"
APP_URL="https://yourdomain.com"

# Database Configuration (Local zero-config store or Hostinger MySQL credentials)
DB_CONNECTION="local"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="exampro_v2"
DB_USERNAME=""
DB_PASSWORD=""

# GEMINI_API_KEY: Required for AI Question Extraction from PDFs
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RAZORPAY: Standard .env keys (also editable directly inside Admin Panel -> Settings)
RAZORPAY_KEY="MY_RAZORPAY_KEY"
RAZORPAY_SECRET="MY_RAZORPAY_SECRET"
RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"

# MAIL / SMTP: Standard SMTP settings (Gmail App Password or Hostinger Email SMTP)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_ENCRYPTION="tls"
MAIL_USERNAME="MY_GMAIL_ADDRESS"
MAIL_PASSWORD="MY_GMAIL_APP_PASSWORD"
MAIL_FROM_ADDRESS="MY_GMAIL_ADDRESS"
MAIL_FROM_NAME="ExamPro"

# Optional: Set to "false" in strict production to disallow preview OTP fallback if SMTP fails
OTP_ALLOW_PREVIEW_FALLBACK="true"

# Optional: Only needed if serving static dist/ from public_html and API from a separate subdomain
VITE_API_BASE_URL=""

